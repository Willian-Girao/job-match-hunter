{
  "type": "json_schema",
  "json_schema": {
    "name": "annotator",
    "strict": true,
    "schema": {
      "type": "object",
      "properties": {
        "score": {
          "type": "number",
          "description": "Match between OUTPUT and GROUD TRUTH as a percentage."
        },
        "reason": {
          "type": "string",
          "description": "What are the reasons for the score given."
        }
      },
      "required": [
        "score",
        "reason"
      ],
      "additionalProperties": false
    }
  }
}