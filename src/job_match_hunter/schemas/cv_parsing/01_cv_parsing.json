{
  "type": "json_schema",
  "json_schema": {
    "name": "cv_data_01",
    "strict": true,
    "schema": {
      "type": "object",
      "properties": {
        "technical_skills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Programming languages, libraries, frameworks, software, tools, methodologies, equipment, and other technical competencies."
        },
        "work_experience": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "months": {
                "type": "number",
                "description": "Total duration of the job position measured in months."
              },
              "role": {
                "type": "string",
                "description": "Job role."
              },
              "technical_skills": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Technical competencies in the job carried out."
                }
              },
              "work_carried_out": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Work/tasks/responsabilities in the job carried out."
                }
              }
            },
            "required": ["months", "role", "technical_skills", "work_carried_out"],
            "additionalProperties": false
          }
        },
        "education": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "months": {
                "type": "number",
                "description": "Total duration of the education measured in months."
              },
              "level": {
                "type": "string",
                "description": "Level of education (for example, course, bachelor, masters, or PhD)."
              },
              "field": {
                "type": "string",
                "description": "Field of study in the education."
              },
              "technical_skills": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Technical competencies carried out in the education."
                }
              },
              "work_carried_out": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Work/tasks/responsabilities in the education carried out."
                }
              }
            },
            "required": ["months", "level", "field", "technical_skills", "work_carried_out"],
            "additionalProperties": false
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "language": {
                "type": "string",
                "description": "Langague spoken."
              },
              "fluency": {
                "type": "string",
                "description": "Level of fluency in langague."
              }
            },
            "required": ["language", "fluency"],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "technical_skills",
        "work_experience",
        "education",
        "languages"
      ],
      "additionalProperties": false
    }
  }
}