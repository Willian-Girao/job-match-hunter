{
  "type": "json_schema",
  "json_schema": {
    "name": "structured_cv_information",
    "strict": true,
    "schema": {
      "type": "object",
      "properties": {
        "technical_skills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tools, technologies, equipments, softwares, code libraries, code packages, programming languages, algorithms, frameworks, methodologies, fields of science, and such"
        },
        "work_experience": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "years": {
                "type": "number",
                "description": "Total duration in years"
              },
              "role": {
                "type": "string",
                "description": "Job role"
              },
              "technical_skills": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Technical elements (e.g. technologies, frameworks, tools) involved in the job role"
                }
              }
            },
            "required": ["years", "role", "technical_skills"],
            "additionalProperties": false
          }
        },
        "education": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "years": {
                "type": "number",
                "description": "Total duration in years"
              },
              "level": {
                "type": "string",
                "description": "Level of education (e.g. Course, Bachelor, Master, PhD)"
              },
              "field": {
                "type": "string",
                "description": "Field of study"
              },
              "technical_skills": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Technical elements (e.g. technologies, frameworks, tools) involved in the education"
                }
              }
            },
            "required": ["years", "level", "field", "technical_skills"],
            "additionalProperties": false
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "language": {
                "type": "string",
                "description": "Langague spoken"
              },
              "fluency": {
                "type": "string",
                "description": "Level of langague fluency"
              }
            },
            "required": ["language", "fluency"],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "technical_skills",
        "work_experience",
        "education",
        "languages"
      ],
      "additionalProperties": false
    }
  }
}