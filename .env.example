# DATA LAYER

# Public Supabase project URL used by client-side code to connect to the Supabase API.
NEXT_PUBLIC_SUPABASE_URL=...

# Low-privilege Supabase key intended for frontend/public clients.
# Safe to expose in client-side code when Row Level Security (RLS) is configured correctly.
# Access to data is restricted by your RLS policies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=...

# High-privilege Supabase key intended only for trusted backend/server-side code.
# Bypasses Row Level Security and can access all project data.
# Never expose this key in frontend code or commit it to source control.
SUPABASE_SECRET_KEY=...

# MODEL LAYER

# Secret API key used to authenticate requests to OpenRouter.
# Keep server-side and do not commit it to source control.
OPENROUTER_API_KEY=...

# Base URL for the model API gateway.
# For OpenRouter: https://openrouter.ai/api/v1
MODELS_BASE_URL=...